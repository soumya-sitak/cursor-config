{
  "editor.fontFamily": "JetBrains Mono, Cascadia Code, Consolas, monospace",
  "editor.fontLigatures": true,
  "editor.fontSize": 14,
  "editor.lineHeight": 22,
  "editor.letterSpacing": 0.2,
  "editor.wordWrap": "off",
  "editor.minimap.enabled": false,
  "editor.lineNumbers": "relative",
  "editor.renderWhitespace": "selection",
  "editor.cursorBlinking": "solid",
  "editor.cursorSmoothCaretAnimation": "off",
  "editor.cursorStyle": "line",
  "editor.smoothScrolling": false,
  "editor.formatOnSave": true,
  "editor.inlineSuggest.enabled": true,
  "editor.quickSuggestions": {
    "other": true,
    "comments": false,
    "strings": false
  },
  "editor.suggestOnTriggerCharacters": true,
  "editor.tabCompletion": "on",
  "editor.snippetSuggestions": "inline",
  "editor.bracketPairColorization.enabled": false,
  "editor.guides.bracketPairs": false,
  "editor.guides.indentation": true,
  "editor.inlayHints.enabled": "offUnlessPressed",
  "editor.stickyScroll.enabled": false,
  "editor.linkedEditing": false,
  "editor.codeLens": false,
  "editor.occurrencesHighlight": "off",
  "editor.selectionHighlight": false,
  "editor.largeFileOptimizations": true,
  "editor.hover.delay": 500,
  "editor.hover.sticky": false,
  "editor.lightbulb.enabled": "off",
  "editor.matchBrackets": "near",
  "editor.renderLineHighlight": "line",
  "editor.hideCursorInOverviewRuler": true,
  "editor.overviewRulerBorder": false,
  "workbench.colorTheme": "Aurora Borealis",
  "workbench.iconTheme": "material-icon-theme",
  "workbench.startupEditor": "none",
  "workbench.activityBar.location": "default",
  "workbench.sideBar.location": "left",
  "workbench.panel.defaultLocation": "bottom",
  "workbench.editor.splitSizing": "split",
  "workbench.editor.showTabs": "multiple",
  "workbench.editor.wrapTabs": false,
  "workbench.editor.closeEmptyGroups": true,
  "workbench.tree.indent": 8,
  "workbench.tree.renderIndentGuides": "none",
  "workbench.tips.enabled": false,
  "workbench.statusBar.visible": true,
  "workbench.list.smoothScrolling": false,
  "breadcrumbs.enabled": false,
  "window.commandCenter": false,
  "window.autoDetectColorScheme": false,
  "terminal.integrated.defaultProfile.windows": "PowerShell",
  "terminal.integrated.fontFamily": "CaskaydiaCove Nerd Font, MesloLGS NF, Consolas, monospace",
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.lineHeight": 1.1,
  "terminal.integrated.letterSpacing": 0,
  "terminal.integrated.fontWeight": "normal",
  "terminal.integrated.fontWeightBold": "bold",
  "terminal.integrated.fontLigatures": false,
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.cursorBlinking": false,
  "terminal.integrated.smoothScrolling": false,
  "terminal.integrated.scrollback": 5000,
  "terminal.integrated.tabs.enabled": true,
  "terminal.integrated.enableMultiLinePasteWarning": "never",
  "terminal.integrated.stickyScroll.enabled": false,
  "terminal.integrated.gpuAcceleration": "auto",
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.tabSize": 4,
    "editor.rulers": [
      88
    ]
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[yaml]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "[dockerfile]": {
    "editor.defaultFormatter": "ms-azuretools.vscode-containers"
  },
  "[toml]": {
    "editor.defaultFormatter": "tamasfe.even-better-toml"
  },
  "cursorpyright.analysis.typeCheckingMode": "basic",
  "cursorpyright.analysis.autoImportCompletions": true,
  "cursorpyright.analysis.completeFunctionParens": true,
  "cursorpyright.analysis.autoFormatStrings": true,
  "cursorpyright.analysis.inlayHints.variableTypes": false,
  "cursorpyright.analysis.inlayHints.functionReturnTypes": false,
  "cursorpyright.analysis.inlayHints.callArgumentNames": false,
  "cursorpyright.analysis.diagnosticMode": "openFilesOnly",
  "python.terminal.activateEnvironment": true,
  "python.testing.pytestEnabled": false,
  "ruff.enable": true,
  "ruff.lint.enable": true,
  "notebook.lineNumbers": "off",
  "notebook.output.textLineLimit": 200,
  "notebook.cellEditTimeout": 0,
  "jupyter.execution.timeout": 300,
  "jupyter.themeMatplotlibPlots": false,
  "diffEditor.ignoreTrimWhitespace": false,
  "problems.decorations.enabled": false,
  "files.autoSave": "onFocusChange",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.mypy_cache": true,
    "**/.ruff_cache": true,
    "**/.DS_Store": true,
    "**/*.egg-info": true,
    "**/node_modules": true,
    "**/dist": true,
    "**/build": true,
    "**/.next": true,
    "**/.turbo": true,
    "**/coverage": true
  },
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/__pycache__/**": true,
    "**/.pytest_cache/**": true,
    "**/.mypy_cache/**": true,
    "**/.ruff_cache/**": true,
    "**/dist/**": true,
    "**/build/**": true,
    "**/.next/**": true,
    "**/.turbo/**": true,
    "**/coverage/**": true,
    "**/.venv/**": true,
    "**/venv/**": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/__pycache__": true,
    "**/.git": true,
    "**/.pytest_cache": true,
    "**/.mypy_cache": true,
    "**/.ruff_cache": true,
    "**/dist": true,
    "**/build": true,
    "**/.next": true,
    "**/.turbo": true,
    "**/coverage": true,
    "**/.venv": true,
    "**/venv": true
  },
  "git.autofetch": false,
  "git.enableSmartCommit": true,
  "git.decorations.enabled": false,
  "scm.diffDecorations": "none",
  "git.confirmSync": true,
  "code-runner.runInTerminal": true,
  "code-runner.saveFileBeforeRun": true,
  "continue.enableTabAutocomplete": false,
  "yaml.schemas": {
    "file:///c%3A/Users/soumya.nayak/.cursor/extensions/continue.continue-2.0.0-win32-x64/config-yaml-schema.json": [
      ".continue/**/*.yaml"
    ]
  }
}
